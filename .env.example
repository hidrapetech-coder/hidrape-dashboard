# Configurações do Servidor
PORT=3002
NODE_ENV=development
FRONTEND_URL=http://localhost:3002
ALLOWED_ORIGINS=http://localhost:3002

# Banco de Dados (Supabase)
# DATABASE_URL deve usar porta 6543 (Pooler) e anexar ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL deve usar porta 5432 (Sem Pooler) para migrations
DIRECT_URL="postgresql://postgres:[SENHA]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Redis (Upstash / Vercel KV)
REDIS_URL="rediss://default:[SENHA]@epic-bird-12345.upstash.io:6379"

# Segurança: gere chaves privadas diferentes; JWT >= 32 caracteres, AES exatamente 32 bytes.
JWT_SECRET=
ENCRYPTION_KEY=

# Integrações IoT (Opcionais se fornecido via app, mas globais podem ficar aqui)
BLYNK_TOKEN=seu_blynk_token_aqui
BLYNK_URL=https://blynk.cloud/external/api/get

# WhatsApp via CallMeBot Conf (Padrão para envio, pode ser sobrescrito pelo cliente)
WHATSAPP_PHONE=5581999999999
CALLMEBOT_APIKEY=sua_apikey_aqui

# IA
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=false
GEMINI_TIMEOUT_MS=15000
GEMINI_MAX_CALLS_PER_USER_DAY=20
GEMINI_MAX_OUTPUT_TOKENS=512
GEMINI_TEMPERATURE=0
# SMTP
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=ethereal_user
SMTP_PASS=ethereal_pass

# Fase 1 agro: desativada por padrão. Nunca reutilizar o banco/segredos do login.
# Consulte MIGRACAO_AGRO4_FASE_1.md antes de ativar.
AGRO4_MODE=agro-3
AGRO_DATABASE_URL=
AGRO_DATABASE_ACK=
AGRO_WORKER_SECRET=
AGRO_POLL_MINUTES=5
AGRO_READING_HEARTBEAT_MINUTES=15
AGRO_DECISION_HEARTBEAT_MINUTES=15
AGRO_CHANGE_POINTS=2
AGRO_MISSING_COMMUNICATION_LIMIT=3
AGRO_SOURCE_RETRIES=2
AGRO_SOURCE_TIMEOUT_MS=4000
AGRO_BLYNK_SERVER_URL=https://blynk.cloud
AGRO4_CUTOVER_AT=
AGRO_WORKER_API_URL=
