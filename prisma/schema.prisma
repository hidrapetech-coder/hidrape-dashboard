// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String    @id @default(uuid())
  nome                String
  email               String    @unique
  senha               String
  tipoPlantacao       String    @default("Personalizado")
  cidade              String    @default("São Paulo")
  estado              String    @default("SP")
  lat                 String    @default("-23.5505")
  lon                 String    @default("-46.6333")
  tamanhoFazenda      Float     @default(10)
  blynkToken          String    @default("")
  whatsappPhone       String    @default("")
  callmebotApiKey     String    @default("")
  criadoEm            DateTime  @default(now())
  resetPasswordToken  String?
  resetPasswordExpire DateTime?
  role                String    @default("user")

  sensors             Sensor[]
  logs                Log[]
  talhoes             Talhao[]
  agroLogs            AgroLog[]
}

model Talhao {
  id              String   @id @default(uuid())
  userId          String
  nome            String   @default("Talhão Principal")
  cultura         String   @default("Personalizado")
  tamanhoHectares Float    @default(1)
  criadoEm        DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sensores        Sensor[]
  logsAgro        AgroLog[]
  calibracoes     ModelCalibration[]
}

model Sensor {
  id       String   @id @default(uuid())
  userId   String
  talhaoId String?
  umidade  Float
  status   String
  data     DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  talhao   Talhao?  @relation(fields: [talhaoId], references: [id], onDelete: SetNull)
}

model Log {
  id         String   @id @default(uuid())
  userId     String?
  email      String?
  rota       String
  metodo     String
  ip         String
  userAgent  String?
  statusCode Int?
  timestamp  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AgroLog {
  id               String   @id @default(uuid())
  userId           String
  talhaoId         String?
  timestamp        DateTime @default(now())
  
  dadosUtilizados  String   @db.Text
  dataQualityScore Int      @default(0)
  anomalies        String?  @db.Text
  
  previsao12h      Float?
  previsao24h      Float?
  riscoEstresse    Float?
  nivelConfianca   String   @default("LOW")
  recomendacao     String   @default("MONITORAR")
  fatoresDecisao   String   @db.Text
  
  acaoProdutor     String?
  resultadoReal    Float?
  erroPrevisao     Float?
  
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  talhao           Talhao?  @relation(fields: [talhaoId], references: [id], onDelete: SetNull)
}

model ModelCalibration {
  id              String   @id @default(uuid())
  talhaoId        String   @unique
  dropRateBase    Float    @default(0.8)
  climateWeights  String   @db.Text
  metricas        String   @db.Text
  atualizadoEm    DateTime @default(now())

  talhao          Talhao   @relation(fields: [talhaoId], references: [id], onDelete: Cascade)
}
