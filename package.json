{
  "name": "iot-dashboard",
  "version": "1.0.0",
  "description": "Dashboard SaaS para monitoramento de umidade via Blynk",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node scripts/build.js",
    "postinstall": "node -e \"if(!process.env.PRISMA_SKIP_POSTINSTALL_GENERATE) require('child_process').execSync('npx prisma generate',{stdio:'inherit'})\"",
    "test": "vitest run --config vitest.config.mjs",
    "check:prisma": "node scripts/check-prisma-offline.js",
    "worker:agro": "node workers/agro-start.js",
    "worker:agro:check": "node workers/agro-start.js --check-config",
    "worker:agro:rehearsal": "node workers/agro-rehearsal.js"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "axios": "^1.6.8",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "qs": "^6.16.0",
    "rate-limit-redis": "^6.0.1",
    "zod": "^4.3.6",
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "vitest": "^5.0.1",
    "jsdom": "^30.0.1"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
